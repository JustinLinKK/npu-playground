import argparse
import json
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument('--dev', default='npu2')
parser.add_argument('--emit-mlir', action='store_true')
parser.add_argument('--xclbin-path')
parser.add_argument('--insts-path')
args = parser.parse_args()
manifest = json.loads(Path('/contract/manifest.json').read_text())
tensors = manifest['tensors']
dtypes = {'float16': 'f16', 'float32': 'f32', 'float64': 'f64', 'int32': 'i32', 'int16': 'i16'}
types = ['memref<' + 'x'.join(map(str, t['shape'])) + 'x' + dtypes[t['dtype']] + '>' for t in tensors]
device = 'npu2_2col' if len(tensors) > 3 else 'npu2_1col'
print(f'module {{ aie.device({device}) {{')
print('%shim = aie.tile(0, 0)')
if len(tensors) > 3:
    print('%shim1 = aie.tile(1, 0)')
print('%core = aie.tile(0, 2)')
joined = len(tensors) == 4
if joined:
    print('%mem = aie.tile(0, 1)')
for i, tensor in enumerate(tensors):
    shim = '%shim1' if i >= 2 and tensor['direction'] == 'input' else '%shim'
    consumer = '%mem' if joined and i in (1, 2) else '%core'
    endpoints = shim + ', {' + consumer + '}' if tensor['direction'] == 'input' else '%core, {%shim}'
    print(f'aie.objectfifo @f{i}({endpoints}, 1 : i32) : !aie.objectfifo<{types[i]}>')
kernel_types = list(types)
kernel_fifos = [f'f{i}' for i in range(len(tensors))]
kernel_directions = [t['direction'] for t in tensors]
if joined:
    counts = []
    for t in tensors[1:3]:
        count = 1
        for size in t['shape']:
            count *= size
        counts.append(count)
    joined_type = f'memref<{sum(counts)}x{dtypes[tensors[1]["dtype"]]}>'
    print(f'aie.objectfifo @joined(%mem, {{%core}}, 1 : i32) : !aie.objectfifo<{joined_type}>')
    print(f'aie.objectfifo.link [@f1, @f2] -> [@joined]([0, {counts[0]}] [])')
    kernel_types = [types[0], joined_type, types[3]]
    kernel_fifos = ['f0', 'joined', 'f3']
    kernel_directions = ['input', 'input', 'output']
print('func.func private @compute(' + ', '.join(kernel_types) + ') attributes {link_with = "kernel.o"}')
print('%worker = aie.core(%core) {')
for i, (fifo, typ, direction) in enumerate(zip(kernel_fifos, kernel_types, kernel_directions)):
    port = 'Consume' if direction == 'input' else 'Produce'
    print(f'%a{i} = aie.objectfifo.acquire @{fifo}({port}, 1) : !aie.objectfifosubview<{typ}>')
    print(f'%v{i} = aie.objectfifo.subview.access %a{i}[0] : !aie.objectfifosubview<{typ}> -> {typ}')
print('func.call @compute(' + ', '.join(f'%v{i}' for i in range(len(kernel_types))) + ') : (' + ', '.join(kernel_types) + ') -> ()')
for fifo, direction in zip(kernel_fifos, kernel_directions):
    port = 'Consume' if direction == 'input' else 'Produce'
    print(f'aie.objectfifo.release @{fifo}({port}, 1)')
print('aie.end }')
print('aie.runtime_sequence(' + ', '.join(f'%arg{i}: {t}' for i, t in enumerate(types)) + ') {')
for i, tensor in enumerate(tensors):
    length = 1
    for size in tensor['shape']:
        length *= size
    print(f'%t{i} = aiex.dma_configure_task_for @f{i} {{')
    print(f'aie.dma_bd(%arg{i} : {types[i]} offset = 0 len = {length} sizes = [1, 1, 1, {length}] strides = [0, 0, 0, 1])')
    print('aie.end }' + (' {issue_token = true}' if tensor['direction'] == 'output' else ''))
    print(f'aiex.dma_start_task(%t{i})')
for i, tensor in enumerate(tensors):
    if tensor['direction'] == 'output':
        print(f'aiex.dma_await_task(%t{i})')
for i in range(len(tensors)):
    print(f'aiex.dma_free_task(%t{i})')
print('} } }')
